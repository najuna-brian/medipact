# Hedera Network Credentials
# Get free account at https://portal.hedera.com/dashboard
# 
# For MediPact development, credentials are stored in adapter/.env
# (This file is gitignored for security)
#
# Follows official Hiero SDK environment variable naming conventions

# Required: Operator account ID (the account that pays for transactions)
OPERATOR_ID="0.0.xxxxx"

# Required: Operator private key (ECDSA format, HEX encoded)
OPERATOR_KEY="0x..."

# Required: Network to connect to (mainnet, testnet, previewnet, localhost)
# MVP: Set to 'testnet' for MVP/demo (free, safe for testing)
# Production: Set to 'mainnet' for production
HEDERA_NETWORK="testnet"

# MVP Configuration (for demo/testing)
# Production: Set NODE_ENV="production" for production deployment
NODE_ENV="development"
LOG_LEVEL="INFO"
PORT=8080

# Security
JWT_SECRET="your-secret-key-minimum-32-characters-long-for-production"

# Frontend URL (for CORS)
FRONTEND_URL="https://www.medipact.space"

# Database (PostgreSQL for production)
# DATABASE_URL="postgresql://user:password@host:port/database"

# Automatic Withdrawal Configuration
# MVP: Set to "false" for full manual control, or "true" to auto-create withdrawals (still requires manual completion)
AUTOMATIC_WITHDRAWAL_ENABLED="false"
AUTOMATIC_WITHDRAWAL_INTERVAL_MINUTES=1440

# Exchange Rate Configuration
EXCHANGE_RATE_UPDATE_INTERVAL_MINUTES=5
EXCHANGE_RATE_FALLBACK=0.16

# HCS Topic IDs (will be created automatically)
# CONSENT_TOPIC_ID=""
# DATA_TOPIC_ID=""

# Smart Contract Addresses (EVM format: 0x...)
# Deployed to Hedera Testnet - See contracts/deployment-info.json
CONSENT_MANAGER_ADDRESS="0xf2423F1E568eC90921045be96Ad2D618fCcd9841"
REVENUE_SPLITTER_ADDRESS="0xCc7DF673dE5d24D295cdd7a503652C18A1aE7392"

# Optional: RevenueSplitter constructor addresses (only for backward compatibility)
# The new distributeRevenueTo() function uses dynamic addresses from the database
# PATIENT_WALLET="0x..."  # Optional: only used for old distributeRevenue() function
# HOSPITAL_WALLET="0x..."  # Optional: only used for old distributeRevenue() function
# MEDIPACT_WALLET="0x..."  # Required: fixed platform wallet (15% of revenue)

# Testnet Auto-Funding (for demo/testing only)
# Set to "true" to automatically fund new accounts with testnet HBAR
# Only works on testnet/previewnet - disabled on mainnet for security
AUTO_FUND_TESTNET_ACCOUNTS="false"
# Amount of HBAR to automatically fund each new account (default: 100, faucet limit is ~100 HBAR per request)
TESTNET_FUNDING_AMOUNT_HBAR="100"

# Optional: API Keys for future integrations
# MOBILE_MONEY_API_KEY=""
# FHIR_API_URL=""

