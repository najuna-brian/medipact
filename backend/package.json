{
  "name": "medipact-backend",
  "version": "1.0.0",
  "description": "MediPact Backend API for patient identity management and hospital registry",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/integration/end-to-end-flow.test.js",
    "setup-admin": "node scripts/setup-admin.js",
    "demo:populate": "node scripts/populate-demo-data.js",
    "demo:datasets": "node scripts/create-datasets-for-demo.js",
    "demo:mvp": "node scripts/create-mvp-datasets.js",
    "hedera:fund": "node scripts/fund-existing-accounts.js",
    "hedera:accounts": "node scripts/test-hedera-accounts.js",
    "data:view": "node scripts/view-researcher-data.js",
    "data:check": "node scripts/check-researcher-payment-data.js",
    "revenue:test": "node scripts/test-revenue-distribution.js",
    "revenue:bulk": "node scripts/test-bulk-revenue.js",
    "metrics:generate": "node scripts/generate-metrics.js",
    "metrics:auto": "node scripts/generate-metrics-automated.js"
  },
  "keywords": [
    "medipact",
    "patient-identity",
    "hospital-registry",
    "healthcare"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hashgraph/sdk": "^2.76.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "notes": {
    "database": "Currently using SQLite for development. PostgreSQL (pg) will be used for production. See docs/DATABASE_MIGRATION.md"
  },
  "devDependencies": {
    "vitest": "^4.0.9"
  }
}
